// examples/apps/nano/main.pul - Nano Text Editor implementation in pure PulseLang
//
// Implements full-screen editor layout, line rendering, keyboard navigation,
// and file persistence without any C or Rust runtime editor builtins.

@contract: @wcet(200us) @budget(1ms);
@import "term";
@include "terminal.pul";
@include "file.pul";
@include "buffer.pul";
@include "screen.pul";

fn render_editor($filename: i64) -> i64 {
    let $c = term_clear();
    let $t = screen_draw_title($filename);

    let $r1 = screen_draw_row(2, 1, "# LatencyOS Hard Real-Time Nano Editor");
    let $r2 = screen_draw_row(3, 2, "Written 100% in pure PulseLang (.pul)");
    let $r3 = screen_draw_row(4, 3, "Zero dynamic heap allocations");
    let $r4 = screen_draw_row(5, 4, "WCET budget enforced by compiler");

    let $b = screen_draw_shortcuts();
    let $m = term_move(2, 6);
    return 0;
}

fn main() -> i64 {
    let $argc = @argc();
    let mut $filename = "README.md";
    let mut $test_only = 0;

    if ($argc > 0) {
        let $arg0 = @arg(0);
        if (@streq($arg0, "--test-render-only")) {
            $test_only := 1;
        } else {
            $filename := $arg0;
        }
    }

    let $init = term_init();
    let $r = render_editor($filename);

    if ($test_only == 1) {
        let $res = term_restore();
        return 0;
    }

    // Interactive Nano Loop
    let mut $running = 1;
    while $running == 1 {
        let $key = term_read();
        if ($key == 113 || $key == 81 || $key == 17 || $key == 24 || $key == 3) { // 'q', 'Q', ^Q (17), ^X (24), ^C (3)
            $running := 0;
        } else if ($key == 19) { // Ctrl+S (19) -> Save
            let $saved = file_save("nano_output.txt", "Saved from PulseLang Nano!\n");
        }
        @busy_wait(100);
    }

    let $res = term_restore();
    return 0;
}

let $code = main();
