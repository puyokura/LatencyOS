// matrix_mul_v32.pul - AI-Native 3x3 Matrix Multiplication with Combinators
@contract: @wcet(25us) @budget(50us);

fn mul($x, $y) -> $ret {
    return $x * $y;
}

let $a = [
    1, 2, 3,
    4, 5, 6,
    7, 8, 9
];

let $b = [
    9, 8, 7,
    6, 5, 4,
    3, 2, 1
];

let mut $c: [i64; 9];

for $i in 0..3 {
    let $row_i = @row($a, $i, 3);

    for $j in 0..3 {
        let $col_j = @col($b, $j, 3);
        
        let $dot = @zip_with($row_i, $col_j, mul) |> @sum();

        $c[($i * 3) + $j] := $dot;
    }
}

@assert($c[0] == 30);
@assert($c[1] == 24);
@assert($c[2] == 18);
@assert($c[3] == 84);
@assert($c[4] == 69);
@assert($c[5] == 54);
@assert($c[6] == 138);
@assert($c[7] == 114);
@assert($c[8] == 90);
@println("[MATRIX_MUL] Complete");
