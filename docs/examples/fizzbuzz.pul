// fizzbuzz.pul - 1-Level Nested Multi-Branch FizzBuzz
@contract: @wcet(10us) @budget(100us);

for $i in 1..16 {
    if (($i % 15) == 0) {
        @println("FizzBuzz");
    } else if (($i % 3) == 0) {
        @println("Fizz");
    } else if (($i % 5) == 0) {
        @println("Buzz");
    } else {
        @println($i);
    }
}
